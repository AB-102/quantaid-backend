# Required
OPENAI_API_KEY=your-openai-api-key
MONGODB_URI=mongodb://127.0.0.1:27017/quantaid-dev  # Local Docker MongoDB (see README)
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/quantaid-test  # Must name a database other than MONGODB_URI's
ADMIN_EMAILS=admin1@email.com,admin2@email.com
JWT_SECRET_KEY=your-jwt-secret-key
IS_RICE_DEPLOYMENT=false  # true only for quantaid.rice.edu (Rice SSO, no Google sign-in)
GOOGLE_CLIENT_ID=your-google-oauth-client-id  # Required when IS_RICE_DEPLOYMENT=false; use the dev/staging client locally

# Dev forced onboarding (optional — set to an email to force onboarding for that email)
# FIRST_TIME_USER_EMAIL=your-dev-forced-onboarding@email.com

# Environment & CORS (optional — sensible defaults if omitted)
# ENVIRONMENT=development # "production" makes the auth cookie Secure; "development" turns on DEBUG logs
# COOKIE_SAMESITE=lax     # "none" only for a cross-site frontend (e.g. Vercel -> Render); needs ENVIRONMENT=production
# JWT_EXPIRE_MINUTES=10080
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Email (optional — leave RESEND_API_KEY unset to turn email off)
# RESEND_API_KEY=re_...your-resend-api-key
# FROM_EMAIL=hello@mail.quantaid.org  # The default; e.g. onboarding@resend.dev with a personal Resend key

# Rice OIDC (optional — not implemented yet)
# RICE_OIDC_CLIENT_ID=
# RICE_OIDC_CLIENT_SECRET=
# RICE_OIDC_REDIRECT_URI=
