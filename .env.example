# Required
OPENAI_API_KEY=your-openai-api-key
MONGODB_URI=your-mongodb-connection-uri
MONGODB_URI_TEST=your-test-mongodb-connection-uri  # must name a database, e.g. .../quantaid-test
ADMIN_EMAILS=admin1@email.com,admin2@email.com
JWT_SECRET_KEY=your-jwt-secret-key

# Dev forced onboarding (optional — set to an email to force onboarding for that email)
# FIRST_TIME_USER_EMAIL=your-dev-forced-onboarding@email.com

# Environment & CORS (optional — sensible defaults if omitted)
# ENVIRONMENT=development # "production" makes the auth cookie Secure + SameSite=None; "development" turns on DEBUG logs
# JWT_EXPIRE_MINUTES=10080
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rice OIDC (optional — not implemented yet)
# RICE_OIDC_CLIENT_ID=
# RICE_OIDC_CLIENT_SECRET=
# RICE_OIDC_REDIRECT_URI=
